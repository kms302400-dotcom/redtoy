CREATE TABLE `g5_redtoy_order_sequence` (
  `reservation_date` DATE NOT NULL,
  `last_serial` INT UNSIGNED NOT NULL DEFAULT 100000,
  PRIMARY KEY (`reservation_date`)
) ENGINE=InnoDB DEFAULT CHARSET=ascii;

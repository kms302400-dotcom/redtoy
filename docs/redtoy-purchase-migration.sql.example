-- New, small table only. Never run this from a web request.
CREATE TABLE IF NOT EXISTS `g5_redtoy_purchase_item` (
  `it_id` VARCHAR(20) NOT NULL,
  `updated_by` VARCHAR(20) NOT NULL DEFAULT '',
  `updated_at` DATETIME NOT NULL,
  PRIMARY KEY (`it_id`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8 COLLATE=utf8_general_ci;

-- Preflight, read-only. Confirm a full covering index starting with it_id and containing od_id.
SHOW INDEX FROM `g5_shop_cart`;
SHOW TABLE STATUS LIKE 'g5_shop_cart';

